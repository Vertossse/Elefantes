@startuml CU-09
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
title CU-09 - Revisión anual del rango de un cliente

package "Interfaz" {
  class VentanaRevisionesAnuales <<boundary>> {
    + mostrarPendientes(revisiones: List<RevisionAnual>)
    + seleccionarCliente(cliente: Cliente)
    + solicitarFacturacionVerificada()
    + mostrarPropuesta(revision: RevisionAnual)
    + mostrarErrorValidacion(mensaje: String)
    + confirmar()
    + cancelar()
  }

  class VentanaAprobacion <<boundary>> {
    + mostrarRevision(revision: RevisionAnual)
    + aprobar()
    + rechazar(motivo: String)
    + cancelar()
  }
}

package "Control" {
  class GestorRevisionesAnuales <<control>> {
    + listarPendientes(): List<RevisionAnual>
    + iniciarRevision(cliente: Cliente, solicitante: Usuario): RevisionAnual
    + registrarFacturacion(revision: RevisionAnual, facturacionVerificada: double)
    + calcularTarifaPropuesta(revision: RevisionAnual): TarifaRango
    + aprobarRevision(revision: RevisionAnual, aprobador: Usuario, tarifa: TarifaRango)
    + rechazarRevision(revision: RevisionAnual, aprobador: Usuario, motivo: String)
    + mantenerTarifa(revision: RevisionAnual)
    + aplicarTarifaAprobada(revision: RevisionAnual)
  }

  class GestorTarifas <<control>> {
    + obtenerTarifasVigentes(fecha: Date): List<TarifaRango>
  }

  class GestorClientes <<control>> {
    + obtenerClientePorNif(nif: String): Cliente
  }

  class GestorSuscripciones <<control>> {
    + obtenerSuscripcion(cliente: Cliente): Suscripcion
    + aplicarNuevaTarifa(suscripcion: Suscripcion, tarifa: TarifaRango, fechaEfecto: Date)
  }

  class GestorMovimientos <<control>> {
    + registrarAuditoria(tabla: String, idRegistro: String, accion: TipoAccionAuditoria, usuario: Usuario, valorAnterior: JSON, valorNuevo: JSON)
  }

  class AutenticadorValidador <<static>> {
    + comprobarPermiso(usuario: Usuario, operacion: String, cliente: Cliente): boolean
    + comprobarSeparacionFunciones(solicitante: Usuario, aprobador: Usuario): boolean
  }
}

package "Dominio" {
  abstract class Usuario <<entity>> {
    - idUsuario: int
    - emailCorporativo: String
    - nombreCompleto: String
    - estadoCuenta: EstadoUsuario
    + puedeAcceder(cliente: Cliente): boolean
  }

  class Administrador <<entity>> {
    - umbralAprobacion: double
  }

  class SuperAdministrador <<entity>>

  class Cliente <<entity>> {
    - nifCif: String
    - nombreComercial: String
    - razonSocial: String
    - domicilioFiscal: String
    - pais: String
    - moneda: String
    - estado: EstadoCliente
    - fechaAlta: Date
    - fechaBajaEfectiva: Date
    - motivoBaja: String
    - suscripcion: Suscripcion
    - revisionAnual: RevisionAnual
    + tieneDatosFiscalesCompletos(): boolean
    + estaActivo(): boolean
  }

  class Suscripcion <<entity>> {
    - idSuscripcion: int
    - fechaInicio: Date
    - planContratado: String
    - tarifaAcordada: double
    - estado: EstadoSuscripcion
    - tarifa: TarifaRango
    - responsableComercial: Usuario
    + aplicarNuevaTarifa(tarifa: TarifaRango, fechaEfecto: Date)
    + debeFacturarse(mes: Date): boolean
  }

  class TarifaRango <<entity>> {
    - idTarifa: int
    - facturacionAnualMinima: double
    - facturacionAnualMaxima: double
    - importeMensualBase: double
    - vigenteDesde: Date
    - vigenteHasta: Date
    + aplicaA(facturacionAnual: double): boolean
    + esValidaEn(fecha: Date): boolean
  }

  abstract class Tarea <<entity>> {
    - idTarea: int
    - estado: EstadoTarea
    - fechaCreacion: DateTime
    - fechaFin: Date
    - ejecutor: EjecutorTarea
    + atender(usuario: Usuario)
    + aplazar(fecha: Date)
  }

  class RevisionAnual <<entity>> {
    - idRevision: int
    - facturacionVerificada: double
    - estadoRevision: EstadoRevisionAnual
    - fechaRevision: DateTime
    - cliente: Cliente
    - tarifaCalculada: TarifaRango
    - tarifaAprobada: TarifaRango
    - solicitante: Usuario
    - aprobador: Usuario
    + calcularTarifaPropuesta(tarifas: List<TarifaRango>): TarifaRango
    + aprobar(usuario: Usuario, tarifa: TarifaRango)
    + rechazar(usuario: Usuario)
    + mantener()
  }

  enum EstadoRevisionAnual {
    Pendiente
    Aprobada
    Rechazada
    Mantenida
  }

  enum EstadoTarea {
    Pendiente
    Atendida
    Cancelada
  }

  enum EjecutorTarea {
    Usuario
    Sistema
  }

  enum EstadoSuscripcion {
    Activa
    Pausada
    ProgramadaFutura
    Cancelada
  }

  enum EstadoCliente {
    Activo
    BajaLogica
    PendienteActivacion
  }

  enum EstadoUsuario {
    Activo
    Desactivado
  }

  enum TipoAccionAuditoria {
    Alta
    Modificacion
    Emision
    Conciliacion
    Reasignacion
    CierrePeriodo
  }
}

package "Persistencia" {
  interface Repositorio<T> {
    + guardar(entidad: T)
    + buscarPorId(id: int): T
    + buscar(filtro: Filtro<T>): List<T>
    + eliminar(entidad: T)
  }

  interface Filtro<T> {
    + criterios(): Map<String, String>
    + orden(): String
  }

  class RepositorioRevisionesAnuales {
    + buscarPendientes(): List<RevisionAnual>
    + buscarPorCliente(cliente: Cliente): RevisionAnual
  }

  class RepositorioTarifas {
    + buscarVigentes(fecha: Date): List<TarifaRango>
  }

  class RepositorioSuscripciones {
    + buscarPorCliente(cliente: Cliente): Suscripcion
  }

  class RepositorioClientes {
    + buscarPorNif(nif: String): Cliente
  }
}

' Layout de control
GestorTarifas -[hidden]down-> GestorClientes
GestorClientes -[hidden]down-> GestorSuscripciones
GestorSuscripciones -[hidden]down-> GestorMovimientos
GestorMovimientos -[hidden]down-> AutenticadorValidador

' Interfaz a control
VentanaRevisionesAnuales ..> GestorRevisionesAnuales : delega
VentanaRevisionesAnuales ..> GestorClientes : carga cliente
VentanaAprobacion ..> GestorRevisionesAnuales : aprueba o rechaza

' Dependencias de control
GestorRevisionesAnuales ..> GestorTarifas : consulta tarifas
GestorRevisionesAnuales ..> GestorClientes : carga cliente
GestorRevisionesAnuales ..> GestorSuscripciones : actualiza tarifa
GestorRevisionesAnuales ..> RepositorioRevisionesAnuales : persiste
GestorRevisionesAnuales ..> AutenticadorValidador : comprueba permiso y separación
GestorRevisionesAnuales ..> GestorMovimientos : audita

GestorTarifas ..> RepositorioTarifas : consulta
GestorClientes ..> RepositorioClientes : persiste
GestorSuscripciones ..> RepositorioSuscripciones : persiste

' Persistencia
Repositorio ..> Filtro : filtra por
Repositorio <|.. RepositorioRevisionesAnuales
Repositorio <|.. RepositorioTarifas
Repositorio <|.. RepositorioSuscripciones
Repositorio <|.. RepositorioClientes
RepositorioRevisionesAnuales ..> RevisionAnual : almacena
RepositorioTarifas ..> TarifaRango : almacena
RepositorioSuscripciones ..> Suscripcion : almacena
RepositorioClientes ..> Cliente : almacena

' Dominio
Cliente "1" *-- "1" Suscripcion : formaliza
Cliente "1" *-- "0..1" RevisionAnual : revisión anual
Suscripcion "0..*" --> "1" TarifaRango : tarifada por
RevisionAnual "0..*" --> "1" TarifaRango : tarifa calculada
RevisionAnual "0..*" --> "0..1" TarifaRango : tarifa aprobada
RevisionAnual "0..*" --> "1" Usuario : solicitante
RevisionAnual "0..*" --> "0..1" Usuario : aprobador

Tarea <|-- RevisionAnual
Usuario <|-- Administrador
Administrador <|-- SuperAdministrador

Cliente ..> EstadoCliente : estado
Suscripcion ..> EstadoSuscripcion : estado
RevisionAnual ..> EstadoRevisionAnual : estado
Tarea ..> EstadoTarea : estado
Tarea ..> EjecutorTarea : ejecutor
Usuario ..> EstadoUsuario : estado

note right of RevisionAnual
  Aprobada: se aplica la tarifa aprobada.
  Rechazada: se mantiene la tarifa anterior.
  Mantenida: mismo tramo, sin cambio de precio.
end note

@enduml
