@startuml CU-11
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 20
skinparam ranksep 40
title CU-11 - Aprobación o rechazo de solicitudes

package "Interfaz" {
  class BandejaAprobaciones <<boundary>> {
    + mostrarPendientes(solicitudes: List<Tarea>)
    + seleccionarSolicitud(solicitud: Tarea)
  }

  class VentanaAprobacion <<boundary>> {
    + mostrarDetalle(solicitud: Tarea)
    + mostrarEfecto(valorAnterior: double, valorNuevo: double)
    + aprobar(comentario: String)
    + rechazar(motivo: String)
    + reasignar(nuevoAprobador: Usuario)
    + mostrarError(mensaje: String)
    + cancelar()
  }
}

package "Control" {
  class GestorAprobaciones <<control>> {
    + listarPendientes(usuario: Usuario): List<Tarea>
    + obtenerDetalle(solicitud: Tarea): Tarea
    + aprobar(solicitud: SolicitudAprobacion, aprobador: Usuario, comentario: String)
    + rechazar(solicitud: SolicitudAprobacion, aprobador: Usuario, motivo: String)
    + aprobarRevision(revision: RevisionAnual, aprobador: Usuario, tarifa: TarifaRango)
    + rechazarRevision(revision: RevisionAnual, aprobador: Usuario, motivo: String)
    + reasignar(solicitud: Tarea, nuevoAprobador: Usuario, administrador: Usuario)
    + aplicarOperacion(solicitud: Tarea)
    + notificarSolicitante(solicitud: Tarea)
  }

  class GestorMovimientos <<control>> {
    + registrarAuditoria(tabla: String, idRegistro: String, accion: TipoAccionAuditoria, usuario: Usuario, valorAnterior: JSON, valorNuevo: JSON)
  }

  class AutenticadorValidador <<static>> {
    + comprobarPermiso(usuario: Usuario, operacion: String, cliente: Cliente): boolean
    + comprobarSeparacionFunciones(solicitante: Usuario, aprobador: Usuario): boolean
    + validarImporteEnUmbral(importe: double, umbral: double): boolean
  }
}

package "Dominio" {
  abstract class Usuario <<entity>> {
    - idUsuario: int
    - emailCorporativo: String
    - nombreCompleto: String
    - estadoCuenta: EstadoUsuario
    + puedeAcceder(cliente: Cliente): boolean
  }

  class Administrador <<entity>> {
    - umbralAprobacion: double
  }

  class SuperAdministrador <<entity>>

  class Cliente <<entity>> {
    - nifCif: String
    - nombreComercial: String
    - razonSocial: String
    - estado: EstadoCliente
    + estaActivo(): boolean
  }

  abstract class Tarea <<entity>> {
    - idTarea: int
    - estado: EstadoTarea
    - fechaCreacion: DateTime
    - fechaFin: Date
    - ejecutor: EjecutorTarea
    + atender(usuario: Usuario)
    + aplazar(fecha: Date)
  }

  class SolicitudAprobacion <<entity>> {
    - idSolicitud: int
    - tipoOperacion: TipoOperacionAprobacion
    - valorSolicitado: double
    - motivo: String
    - resolucion: ResolucionSolicitud
    - fechaResolucion: DateTime
    - cliente: Cliente
    - factura: Factura
    - solicitante: Usuario
    - aprobador: Usuario
    + requiereAprobacion(umbral: double): boolean
    + estaPendiente(): boolean
    + aprobar(aprobador: Usuario, comentario: String)
    + rechazar(aprobador: Usuario, motivo: String)
    + reasignar(aprobador: Usuario)
    + aplicarOperacion()
  }

  class RevisionAnual <<entity>> {
    - idRevision: int
    - facturacionVerificada: double
    - estadoRevision: EstadoRevisionAnual
    - fechaRevision: DateTime
    - cliente: Cliente
    - tarifaCalculada: TarifaRango
    - tarifaAprobada: TarifaRango
    - solicitante: Usuario
    - aprobador: Usuario
    + calcularTarifaPropuesta(tarifas: List<TarifaRango>): TarifaRango
    + aprobar(usuario: Usuario, tarifa: TarifaRango)
    + rechazar(usuario: Usuario)
    + mantener()
  }

  class TarifaRango <<entity>> {
    - idTarifa: int
    - facturacionAnualMinima: double
    - facturacionAnualMaxima: double
    - importeMensualBase: double
    - vigenteDesde: Date
    - vigenteHasta: Date
    + aplicaA(facturacionAnual: double): boolean
    + esValidaEn(fecha: Date): boolean
  }

  abstract class Factura <<entity>> {
    - idFactura: int
    - numeroSerieCompleto: String
    - estado: EstadoFactura
    - total: double
    - fechaEmision: Date
    + esEditable(): boolean
    + emitir(numero: String, fecha: Date)
    + marcarRectificada()
    + marcarIncobrable()
  }

  enum TipoOperacionAprobacion {
    DescuentoTemporal
    PrimerMesGratis
    PrecioPactado
    RectificativaAlta
    CondonacionDeuda
    FacturaPuntualAlta
  }

  enum ResolucionSolicitud {
    Aprobada
    Rechazada
  }

  enum EstadoTarea {
    Pendiente
    Atendida
    Cancelada
  }

  enum EjecutorTarea {
    Usuario
    Sistema
  }

  enum EstadoRevisionAnual {
    Pendiente
    Aprobada
    Rechazada
    Mantenida
  }

  enum EstadoFactura {
    Borrador
    Emitida
    Pagada
    Rectificada
    Incobrable
    Anulada
  }

  enum EstadoCliente {
    Activo
    BajaLogica
    PendienteActivacion
  }

  enum EstadoUsuario {
    Activo
    Desactivado
  }

  enum TipoAccionAuditoria {
    Alta
    Modificacion
    Emision
    Conciliacion
    Reasignacion
    CierrePeriodo
  }
}

package "Persistencia" {
  interface Repositorio<T> {
    + guardar(entidad: T)
    + buscarPorId(id: int): T
    + buscar(filtro: Filtro<T>): List<T>
    + eliminar(entidad: T)
  }

  interface Filtro<T> {
    + criterios(): Map<String, String>
    + orden(): String
  }

  class RepositorioSolicitudesAprobacion {
    + buscarPendientesPorAprobador(aprobador: Usuario): List<SolicitudAprobacion>
    + buscarPorCliente(cliente: Cliente): List<SolicitudAprobacion>
  }

  class RepositorioRevisionesAnuales {
    + buscarPendientes(): List<RevisionAnual>
    + buscarPorCliente(cliente: Cliente): RevisionAnual
  }

  class RepositorioUsuarios {
    + buscarAdministradores(): List<Administrador>
    + buscarSuperadministradores(): List<SuperAdministrador>
  }
}

' Layout de paquetes
AutenticadorValidador -[hidden]down-> Repositorio

' Layout de control
GestorAprobaciones -[hidden]down-> GestorMovimientos
GestorMovimientos -[hidden]down-> AutenticadorValidador

' Layout de interfaz
BandejaAprobaciones -[hidden]down-> VentanaAprobacion

' Interfaz a control
BandejaAprobaciones ..> GestorAprobaciones : delega
VentanaAprobacion ..> GestorAprobaciones : resuelve

' Dependencias de control
GestorAprobaciones ..> RepositorioSolicitudesAprobacion : persiste
GestorAprobaciones ..> RepositorioRevisionesAnuales : persiste
GestorAprobaciones ..> RepositorioUsuarios : busca aprobador
GestorAprobaciones ..> AutenticadorValidador : valida permiso, umbral y separación
GestorAprobaciones ..> GestorMovimientos : audita
GestorAprobaciones ..> SolicitudAprobacion : resuelve
GestorAprobaciones ..> RevisionAnual : resuelve
GestorAprobaciones ..> TarifaRango : aplica tarifa

GestorMovimientos ..> TipoAccionAuditoria : usa

' Persistencia
Repositorio ..> Filtro : filtra por
Repositorio <|.. RepositorioSolicitudesAprobacion
Repositorio <|.. RepositorioRevisionesAnuales
Repositorio <|.. RepositorioUsuarios
RepositorioSolicitudesAprobacion ..> SolicitudAprobacion : almacena
RepositorioRevisionesAnuales ..> RevisionAnual : almacena
RepositorioUsuarios ..> Usuario : almacena

' Dominio
Cliente "1" *-- "0..1" RevisionAnual : revisión anual

SolicitudAprobacion "0..*" --> "1" Cliente : para
SolicitudAprobacion "0..*" --> "1" Usuario : solicitante
SolicitudAprobacion "0..*" --> "0..1" Usuario : aprobador
SolicitudAprobacion "0..*" --> "0..1" Factura : afecta a

RevisionAnual "0..*" --> "1" Usuario : solicitante
RevisionAnual "0..*" --> "0..1" Usuario : aprobador
RevisionAnual "0..*" --> "0..1" TarifaRango : tarifa calculada
RevisionAnual "0..*" --> "0..1" TarifaRango : tarifa aprobada

Tarea <|-- SolicitudAprobacion
Tarea <|-- RevisionAnual
Usuario <|-- Administrador
Administrador <|-- SuperAdministrador

SolicitudAprobacion ..> TipoOperacionAprobacion : tipoOperacion
SolicitudAprobacion ..> ResolucionSolicitud : resolucion
Tarea ..> EstadoTarea : estado
Tarea ..> EjecutorTarea : ejecutor
RevisionAnual ..> EstadoRevisionAnual : estadoRevision
Factura ..> EstadoFactura : estado
Cliente ..> EstadoCliente : estado
Usuario ..> EstadoUsuario : estado

@enduml
