@startuml CU-21
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 20
skinparam ranksep 40
title CU-21 - Conciliación manual de un cobro

package "Interfaz" {
  class VentanaConciliacion <<boundary>> {
    + mostrarMovimiento(movimiento: MovimientoCobro)
    + mostrarFacturasCandidatas(facturas: List<Factura>)
    + seleccionarFactura(factura: Factura)
    + confirmar()
    + deshacer(motivo: String)
    + mostrarError(mensaje: String)
    + cancelar()
  }
}

package "Control" {
  class GestorCobros <<control>> {
    + listarPendientes(usuario: Usuario): List<MovimientoCobro>
    + buscarFacturasCandidatas(movimiento: MovimientoCobro): List<Factura>
    + conciliarManual(movimiento: MovimientoCobro, factura: Factura, usuario: Usuario): Conciliacion
    + revertirConciliacion(conciliacion: Conciliacion, motivo: String, usuario: Usuario)
  }

  class GestorFacturas <<control>> {
    + obtenerFactura(id: int): Factura
    + listarPorCliente(cliente: Cliente): List<Factura>
  }

  class AutenticadorValidador <<static>> {
    + comprobarPermiso(usuario: Usuario, operacion: String, cliente: Cliente): boolean
  }

  class GestorMovimientos <<control>> {
    + registrarAuditoria(tabla: String, idRegistro: String, accion: TipoAccionAuditoria, usuario: Usuario, valorAnterior: JSON, valorNuevo: JSON)
  }
}

package "Dominio" {
  abstract class Usuario <<entity>> {
    - idUsuario: int
    - emailCorporativo: String
    - nombreCompleto: String
    - estadoCuenta: EstadoUsuario
    + puedeAcceder(cliente: Cliente): boolean
  }

  class UsuarioOperativo <<entity>> {
    - carteraClientes: List<Cliente>
    - puedeDarAltaClientes: boolean
  }

  class Administrador <<entity>> {
    - umbralAprobacion: double
  }

  class Cliente <<entity>> {
    - nifCif: String
    - nombreComercial: String
    - razonSocial: String
    - estado: EstadoCliente
    - facturas: List<Factura>
    + estaActivo(): boolean
  }

  abstract class Factura <<entity>> {
    - idFactura: int
    - numeroSerieCompleto: String
    - estado: EstadoFactura
    - fechaEmision: Date
    - fechaVencimiento: Date
    - total: double
    + estaPendiente(): boolean
    + puedeConciliarse(): boolean
    + marcarPagada()
    + marcarIncobrable()
  }

  class MovimientoCobro <<entity>> {
    - idMovimiento: int
    - fuentePasarela: FuentePasarela
    - referenciaTransaccion: String
    - fechaOperacion: DateTime
    - importeRecibido: double
    - moneda: String
    - conceptoBanco: String
    + esDuplicado(): boolean
    + coincideCon(factura: Factura): boolean
  }

  class Conciliacion <<entity>> {
    - idConciliacion: int
    - tipo: TipoConciliacion
    - discrepanciaImporte: double
    - fecha: DateTime
    - estado: EstadoConciliacion
    - cobro: MovimientoCobro
    - factura: Factura
    + tieneDiscrepancia(): boolean
    + revertir(motivo: String)
  }

  enum FuentePasarela {
    Stripe
    Revolut
    Banco
  }

  enum TipoConciliacion {
    Automatica
    Manual
  }

  enum EstadoConciliacion {
    Conciliado
    Revertido
  }

  enum EstadoFactura {
    Borrador
    Emitida
    Pagada
    Rectificada
    Incobrable
    Anulada
  }

  enum EstadoCliente {
    Activo
    BajaLogica
    PendienteActivacion
  }

  enum EstadoUsuario {
    Activo
    Deshabilitado
  }

  enum TipoAccionAuditoria {
    Alta
    Modificacion
    Emision
    Conciliacion
    Reasignacion
    CierrePeriodo
  }
}

package "Persistencia" {
  interface Repositorio<T> {
    + guardar(entidad: T)
    + buscarPorId(id: int): T
    + buscar(filtro: Filtro<T>): List<T>
    + eliminar(entidad: T)
  }

  interface Filtro<T> {
    + criterios(): Map<String, String>
    + orden(): String
  }

  class RepositorioMovimientosCobro {
    + buscarPendientes(): List<MovimientoCobro>
    + buscarPorReferencia(referencia: String): MovimientoCobro
  }

  class RepositorioConciliaciones {
    + buscarPorFactura(factura: Factura): List<Conciliacion>
    + guardar(conciliacion: Conciliacion)
  }

  class RepositorioFacturas {
    + buscarPorCliente(cliente: Cliente): List<Factura>
    + buscarPorId(id: int): Factura
  }
}

' Layout
GestorCobros -[hidden]down-> Repositorio
AutenticadorValidador -[hidden]down-> Repositorio

' Persistencia en fila para reducir el alto y los cruces
RepositorioMovimientosCobro -[hidden]right-> RepositorioConciliaciones
RepositorioConciliaciones -[hidden]right-> RepositorioFacturas
RepositorioFacturas -[hidden]right-> Filtro

' Interfaz a control
VentanaConciliacion ..> GestorCobros : resuelve

' Control
GestorCobros ..> RepositorioMovimientosCobro : busca cobros
GestorCobros ..> RepositorioFacturas : busca facturas
GestorCobros ..> RepositorioConciliaciones : persiste
GestorCobros ..> AutenticadorValidador : valida permiso
GestorCobros ..> GestorMovimientos : audita
GestorCobros ..> MovimientoCobro : evalúa
GestorCobros ..> Conciliacion : crea
GestorCobros ..> Factura : marca pagada

GestorFacturas ..> RepositorioFacturas : persiste
GestorMovimientos ..> TipoAccionAuditoria : usa

' Persistencia
Repositorio ..> Filtro : filtra por
Repositorio <|.. RepositorioMovimientosCobro
Repositorio <|.. RepositorioConciliaciones
Repositorio <|.. RepositorioFacturas
RepositorioMovimientosCobro ..> MovimientoCobro : almacena
RepositorioConciliaciones ..> Conciliacion : almacena
RepositorioFacturas ..> Factura : almacena

' Dominio
Cliente "1" --> "0..*" Factura : facturas
Factura "1" --> "0..*" Conciliacion : conciliaciones
Conciliacion "0..*" --> "1" MovimientoCobro : cobro
Conciliacion "0..*" --> "1" Factura : factura

Usuario <|-- UsuarioOperativo
Usuario <|-- Administrador

Factura ..> EstadoFactura : estado
Cliente ..> EstadoCliente : estado
Usuario ..> EstadoUsuario : estado
MovimientoCobro ..> FuentePasarela : fuentePasarela
Conciliacion ..> TipoConciliacion : tipo
Conciliacion ..> EstadoConciliacion : estado

@enduml
