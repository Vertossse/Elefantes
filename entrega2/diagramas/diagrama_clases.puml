@startuml
package ClasesClientes {
  class Cliente <<entity>> {
  -idCliente : int 
  -nifCif : String
  -nombreComercial : String 
  -razonSocial : String 
  -domicilioFiscal : String 
  -pais : String 
  -moneda : String 
  -estado : EstadoCliente 
  -fechaAlta : Date
  -fechaBajaEfectiva : Date
  -motivo : String 
  -idTareaEliminar : int 
  -contacto : List<Contacto>
  -etiquetas : List<Etiqueta>
  -suscripcion : Suscripcion
  -revision_anual : RevisionAnual
  -responsable : Usuario_Operativo

  +tieneDatosFiscalesCompletos() : boolean 
  +darDeBaja(String motivo, Date fecha) : void 
  +reactivar() : void 
  +anyadirEtiqueta(Etiqueta etiqueta) : void 
  +quitarEtiqueta(Etiqueta etiqueta) : void 
  +tieneContactoFacturacion() : boolean 
  }

  enum EstadoCliente {
    ACTIVO 
    PAUSADO 
    INACTIVO 
  }

  class Etiqueta {
    -idEtiqueta : int
    -nombre : String
    -colorHex : String  
  }

  package ClasesContacto {
    class Contacto <<entity>> {
    -idContacto : int
    -nombreCompleto : String 
    -email : String
    -telefono : String 
    -rolContacto : RolesContacto 
    -canalesConsentidos : Map<Canal, String> 
    -estado : EstadoContacto

    +activar() : void 
    +desactivar() : void 
    +anonimizar() : void 
    +admiteCanal(Canal canal) : boolean 
    }

    enum RolesContacto {
    FACTURACION
    CONTRATACION
    IMPAGOS 
    }

    enum EstadoContacto {
    ACTIVO
    INACTIVO
    ANONIMIZADORGPD
    }

    enum Canal {
      EMAIL
      WHATSAPP
    }

    Contacto "*" --> "1" RolesContacto
    Contacto "*" --> "1" EstadoContacto
    Contacto "*" --> "1...*" Canal 
  }
  Cliente "*" --> "1" EstadoCliente 
  Cliente "*" --o "1...*" Contacto
  Cliente "*" --o "1...*" Etiqueta  
}

package ClasesSuscripcion {
  class Suscripcion <<entity>> {
  -idSuscripcion: int
  -fechaInicio: Date
  -planContratado: String
  -tarifaAcordada: double
  -estado : EstadoSub
  -motivoPausa: String
  -fechaInicioPausa: Date
  -fechaFinPausaPrevista: Date
  -excepcionSinProrrateo: boolean
  -plazoPagosDias: int
  -rutaDocumentoContrato: String
  -excepcionComercial: ExcepcionComercial 

  +calcularProrrateoPrimerMes(): double
  +pausar(String motivo, Date fecha, Date fin): void
  +reactivar(): void
  +cancelar(): void
  +debeFacturarse(int mes): boolean
  +aplicarNuevaTarifa(double tarifa, Date fechaEfecto): void
  }

  enum EstadoSub {
  ACTIVA
  PAUSADA 
  PROGRAMADAFUTURA
  CANCELADA
  }

  package ClasesExcepcion {
    class ExcepcionComercial <<entity>> {
      -idExcepcion : int
      -tipoExcepcion : ExcepcionesPosibles
      -descuento : double
      -vigenteDesde : Date 
      -vigenteHasta : Date

      +estaVigente(Date fecha) : boolean 
      +aplicar(Factura factura) : void 
    }

    enum ExcepcionesPosibles {
      PRIMERMESGRATIS
      DESCUENTOTEMPORAL
      PRECIOPACTADO
      SINPRORRATEO 
    }

    ExcepcionComercial "*" --> "1" ExcepcionesPosibles
  }

  Suscripcion "*" --> "0...1" ExcepcionComercial
  Suscripcion "*" --> "1" EstadoSub
  Suscripcion "1" --* "1" Cliente 
}

package ClasesFacturas {
  abstract class Factura <<entity>> {
  -idFactura : int
  -numeroSerieCompleto : String
  -serie : String 
  -numeroSecuencia : int 
  -estado : EstadoFactura
  -fechaEmision : Date 
  -fechaVencimiento : Date 
  -moneda : String 
  -subtotal : double 
  -impuestos : double 
  -total : double 
  -esMigradaHistorica : boolean 
  -recibirNotificaciones : boolean 
  -creador : Usuario
  -conceptos : List<Concepto> 
  -periodo : PeriodoAdministrativo
  -clienteAsociado : Cliente 

  +recalcularTotales() : double 
  +esEditable() : boolean
  +emitir(Date fechaEmision) : void 
  +desactivarNotificaciones() : void 
  +reactivarNotificaciones() : void 
  +marcarPagada() : void
  +marcarRectificada() : void 
  +marcarInconbrable() : void 
  }

  enum EstadoFactura {
  BORRADOR 
  EMITIDA 
  PAGADA  
  ANULADA 
  RECTIFICADA 
  INCOBRABLE 
  }
  
  class Factura_Puntual <<entity>> {
  -presupuestoOrigen : String 
  }

  class Factura_Recurrente <<entity>> {
  -mesFacturado : Date 
  }
  Factura_Recurrente "*" ..> "1" Suscripcion
  
  class Factura_Rectificada <<entity>> {
  -ifdFacturaOriginal : int 
  -motivoRectificacion : String 
  -importeAjustado : double 
  }
  Factura "*" --> "1" EstadoFactura 
  Factura_Puntual --|> Factura
  Factura_Recurrente --|> Factura 
  Factura_Rectificada --|> Factura

  class Concepto <<entity>> {
    -idConcepto : int 
    -nombre : String 
    -descripcionPorDefecto : String 
    -precioBase : double 
    -impuestoPorDefecto : double 
    -activo : boolean 
  }
  Concepto "1...*" --o "*" Factura 
  Factura "1...*" --> "1" Cliente 
  Factura "1...*" --* "1"Cliente 
}

package ClasesEmpleados {
  abstract class Usuario <<entity>> {
  -idUsuario : int
  -emailCorporativo : String
  -passwordHash : String
  -estado : EstadoCuenta 
  -fechaAlta : Date
  -ultimoAcceso : Date
  -tieneRestriccionesClientes : boolean 

  +autenticarPassword(String password) : boolean 
  +cambiarPassword(String password) : void 
  +desactivar() : void 
  +reactivar() : void
  +puedeAccederACliente(Cliente cliente) : boolean  
  } 

  enum EstadoCuenta {
  ACTIVADO
  DESACTIVADO
  }
  
  package ClasesUsuarioPorRoles {
    class Usuario_Operativo <<entity>> {
      -asignaciones : List<Cliente>

      +puedeDarAltaClientes() : boolean 
      +asignadoA(Cliente) : boolean 
    }
    
    class Administrador <<entity>> {
      -umbralAprobacion : double 
    }
    class SuperAdministrador
    Usuario_Operativo --|> Usuario
    Administrador --|> Usuario
    SuperAdministrador --|> Usuario
    Usuario_Operativo --> Cliente
  }
  Usuario "*" --> "1" EstadoCuenta 
}

    PeriodoAdministrativo "*" --> "1" EstadoPeriodo
    PeriodoAdministrativo ..> Usuario
    Factura "*" --> "1" PeriodoAdministrativo

    RevisionAnual "*" --> "1" EstadoRevision
    RevisionAnual "*" --* "1" Cliente 

package ClasesMovimiento {
  enum TipoMovimiento {
    ENVIOCOMUNICACION 
    REGISTROAUDITORIA 
    ImportacionCSV
    CIERREPERIODOADMINISTRATIVO 
    ALTABAJACLIENTE
    ALTABAJAUSUARIO 
    ASIGNACIONDESASIGNACIONCLIENTE
    GENERACIONFACTURA 
    RECTIFICACIONFACTURA 
    GENERACIONINFORME
    APLICACIONEXCEPCIONCOMERCIAL 
    REGISTROCOBRO 
    REGISTROTAREA 
  }

  abstract class Movimiento <<entity>>{
    -idMovimiento :  int
    -fecha : Date 
    -encargado : Usuario 
    -detalle : String 
  }

  package SubclasesMovimiento {
    package ClasesEnvioComunicacion {
      class EnvioComunicacion <<entity>> {
      -Notificacion : Notificacion 
      -factura : Factura 
      -contaco : Contacto 
      -tipoMensaje : TipoMensaje 
      -estado : EstadoMensaje 
      -esReintentado : boolean 
      -numeroIntento : int 

      +marcarEnviado() : void 
      +marcarRebotado() : void 
      +reenviar() : void 
      }

      enum TipoMensaje {
        FACTURA
        RECORDATORIO 
        IMPAGO 
      }

      enum EstadoMensaje {
        ENCOLA
        ENVIADO 
        FALLIDOREBOTADO 
        REINTENTADO 
      }

      EnvioComunicacion "*" --> "1" TipoMensaje
      EnvioComunicacion "*" --> "1" EstadoMensaje
      EnvioComunicacion --|> Movimiento
    }

    package ClasesRegistroAuditoria {
       class RegistroAuditoria <<entity>> {
        -csvDatos : CSV 
        -tablaAfectada : Factura 
        -idRegistroAfectado : int
        -tipoAccion : TipoAccion 
        -valorAnterior : JSON 
        -valorNuevo : JSON 
      }

      enum TipoAccion {
        ALTA
        MODIFICACION 
        EMISION 
        CONCILIACION 
        RESIGNACION 
        CIERREPERIODO 
      }

      RegistroAuditoria "*" --> "1" TipoAccion
      RegistroAuditoria --|> Movimiento
    }

    package ClasesImportacionCSV {
      class ImportacionCSV <<entity>> {
        -nombreArchivo : CSV 
        -filasTotales : int 
        -filasCorrectas : int 
        -estado : EstadoCSV 
      }

      enum EstadoCSV {
        VALIDO
        INVALIDO 
      }

      ImportacionCSV "*" --> "1" EstadoCSV 
      ImportacionCSV --|> Movimiento
    }

    package ClasesOtrosMovimientos {
      class CierrePeriodoAdministrativo <<entity>> {
        -periodoCerrado : PeriodoAdministrativo
      }

      class AltaBajaCliente <<entity>> {
        -esBaja : boolean 
        -cliente : Cliente 
      }

      class AltaBajaEmpleado <<entity>> {
        -esBaja : boolean 
        -empleadoAfectado : Usuario 
      }

      class AsignacionDesasigancionCliente <<entity>> {
        -esAsignacion : boolean 
        -clienteAfectado : Cliente 
        -responsableOriginal : Usuario 
        -responsableNuevo : Usuario 
      }

      class AsignacionDesasignacionContacto <<entity>> {
        -esAsignacion : boolean 
        -clienteAfectado : Cliente 
        -contactoAfectado : Contacto 
      }

      class GeneracionFactura <<entity>> {
        -facturaGenerada : Factura 
      }

      class RectificacionFactura <<entity>> {
        -facturaRectificada : Factura 
        -fechaRectificacion : Date 
      }

      class GeneracionInforme <<entity>> {
        -informeGenerado : Informe 
      }

      class AplicarExcepcionComercial <<entity>> {
        -facturaAfectada : Factura 
        -clienteResponsable : Cliente 
        -excepcionApliacada : ExcepcionComercial 
      }

      class RegistroCobro <<entity>> {
        -conciliacion : Conciliacion 
      }

      class RegistroTarea <<entity>> {
        -tareaRegistrada : Tarea 
      }
    }
    note right of ClasesOtrosMovimientos
      Todas las clases de este paquete heredan
      de la clase Movimiento y no se pondrán por
      el momento todas esas flechas para simplicar
      el diagrama, pero se entiende que toda clase
      no enumeradas dentro del paquete 
      SubclasesMovimiento hereda de Movimiento
    end note 
  }
}

package ClasesNotificacion {
  abstract class Notificacion <<entity>> {
    -idNotificacion : int 
    -asunto : String 
    -texto : String 
    -fecha : Date 
    -usuarioResponsable : Usuario 
    -detalle : String 
  }

  package SubclasesDeNotificacion {
    class WhatsApp <<entity>> {
      -telefonoOrigen : String 
      -telefonoDestino : String 
    }

    class CorreoElectronico <<entity>> {
      -correoOrigen : String 
      -correoDestion : String 
    }

    class NotificacionInterna <<entity>> {
      -usuarioReceptor : Usuario
      -leida : boolean 
  
      +marcarLeida() : void  
    }

    WhatsApp --|> Notificacion
    CorreoElectronico --|> Notificacion
    NotificacionInterna --|> Notificacion
    EnvioComunicacion --> Notificacion
  }
}

package ClasesPaqueteConciliacion {
  package ClasesConciliacion {
    class Conciliacion <<entity>> {
    -idConciliacion : int 
    -tipo : TipoConciliacion 
    -discrepanciaImporte : double 
    -fecha : Date 
    -motivoRevertido : String 
    -estadoConciliacion : EstadoConciliacion 
    -movimiento : MovimientoCobro
    -facturaAsociada : Factura 

    +tieneDiscrepancia() : boolean 
    +revertir(String motivo) : void 
    }

    enum TipoConciliacion {
      AUTOMATICA
      MANUAL 
    }

    enum EstadoConciliacion {
      CONCILIADO 
      REVERTIDO 
    }

    Conciliacion "*" --> "1" TipoConciliacion
    Conciliacion "*" --> "1" EstadoConciliacion 
    RegistroCobro "0...1" --> "1" Conciliacion
  }

  package ClasesMovimientoCobro {
    class MovimientoCobro <<entity>> {
    -idMovimiento : int 
    -fuentePasarela : PasarelasPago
    -referenciaTransaccion : String 
    -fechaOperacion : Date 
    -importeRecibido : double 
    -moneda : String 
    -conceptoBanco : String 

    +esDuplicado() : boolean 
    +coincideCon(Factura factura) : boolean 
    }

    enum PasarelasPago {
      STRIPE 
      REVOLUT 
      BANCO 
    }
    
    Conciliacion "1" --o "0...1" MovimientoCobro 
    MovimientoCobro "*" --> "1" PasarelasPago
  }
}

    EnvioComunicacion "*" --> "1" Contacto 
    AltaBajaCliente "*" --> "1" Cliente 
    AsignacionDesasigancionCliente "*" --> "1" Cliente 
    AplicarExcepcionComercial "*" --> "1" Cliente 

    EnvioComunicacion "*" --> "0...1" Factura 
    RegistroAuditoria "*" --> "0...1" Factura 
    GeneracionFactura "1" --> "1" Factura 
    RectificacionFactura "1" --> "0...1" Factura 
    AplicarExcepcionComercial "*" --> "1" Factura 
    AplicarExcepcionComercial "*" --> "1" ExcepcionComercial
    Conciliacion "0...1" --> "1" Factura 

    Movimiento "*" --> "1" Usuario  
    AltaBajaEmpleado "*" --> "1" Usuario
    AsignacionDesasigancionCliente "*" --> "1" Usuario 
    Notificacion "*" --> "1" Usuario
    NotificacionInterna "*" --> "1" Usuario 

    CierrePeriodoAdministrativo "*" --> "1" PeriodoAdministrativo

    GeneracionInforme "1" --> "1" Informe 

    RegistroTarea "1" --> "1" Tarea 

package ClasesTarea {
  package ClaseAbstractaTarea {
    enum TipoTarea {
      DELEGACIONTEMPORAL 
      REVISIONANUAL 
      DISPUTADEUDA 
      INCIDENCIAFACTURACION 
      SOLICITUDAPROBACION
    }

    abstract class Tarea <<entity>> {
    -idTarea : int 
    -estado : EstadoTarea 
    -fechaCreacion : Date 
    -fechaAplazada : Date 
    -fechaFin : Date 
    -ejectucor : Ejecutores 

    +resolver(Usuario usuario) : void 
    +aplazar(Date fecha) : void 
    }

    enum EstadoTarea {
      PENDIENTE
      ATENDIDA
    }

    enum Ejecutores {
      USUARIO
      SISTEMA 
    }

    Tarea "*" --> "1" EstadoTarea
    Tarea "*" --> "1" Ejecutores 
  }

  package SubclasesTarea {
    package SubclasesConEjecutorSistema {
      package ClasesDelegacionTemporal {
        class DelegacionTemporal <<entity>> {
          -idDelegacion : int 
          -estadoDelegacion : EstadoDelegacion 
          -cliente : Cliente 
          -usuarioOrigen : Usuario 
          -usuarioDestino : Usuario 

          +resolver(Usuario usuario) : void
          +aplazar(Date fecha) : void  
          -activar() : void 
          -revocar() : void 
          -caducar() : void 
          +estaVigente(Date fecha) : boolean 
        }

        enum EstadoDelegacion {
          ACTIVA 
          CADUCADA 
          REVOCADA 
        }

        DelegacionTemporal "*" --> "1" EstadoDelegacion
        DelegacionTemporal --|> Tarea 
      }

      package ClasesRevisionAnual {
        class RevisionAnual <<entity>> {
        -idRevision : int
        -facturacionVerificada : double 
        -estadoRevision : EstadoRevision 
        -fechaRevision : Date 
        -tarifaRango : TarifaRango 
        -aprobador : Usuario

        +resolver() : void 
        +aplazar(Date fecha) : void 
        -calcularTarifaPropuesta(TarifaRango tarifa) : TarifaRango
        +aprobar(Usuario usuario, TarifaRango tarifa) : void 
        +rechazar(Usuario usuario) : void 
        +mantener() : void 
        }

        enum EstadoRevision {
        PENDIENTE
        APROBADA
        RECHAZADA 
        MANTENIDA 
        }

        class TarifaRango <<entity>> {
        -idTarifa : int 
        -rangoFacturacionMin : double 
        -rangoFacturacionMax : double 
        -importeMensualBase : double 
        -fechaEfecto : Date 
        -validoHasta : Date 

        +aplicaA(double facturacion) : boolean 
        +estaVigente(Date fecha) : boolean 
        }
        TarifaRango "1" --o "1...*" RevisionAnual
        RevisionAnual --|> Tarea 
      }
    }

    package SubclasesConEjecutorUsuario {
      class DisputaDeuda <<entity>> {
        -idDisputa : int 
        -motivoReclamacion : String 
        -fechaRevisionPrevista : Date 
        -recordatoriosCongelados : boolean 
        -facturaAsociada : Factura 
        -clienteAsociado : Cliente 
        -usuarioResponsable : Usuario 

        +resolver() : void 
        +aplazar(Date fecha) : void 
        -cerrar(Usuario usuario) : void 
        -congelarRecordatorios() : void 
        +recordatoriosCongelados() : boolean 
      }

      DisputaDeuda --|> Tarea 

      package ClasesIncidenciaFacturacion {
        class IncidenciaFacturacion <<entity>> {
          -idIncidencia: int 
          -tipoIncidencia: TiposIncidencia 
          -prioridad: PrioridadIncidencia 
          -estadoIncidencia : EstadoIncidencia
          -pausarRecordatorios: boolean 
          -cliente: Cliente 
          -factura: Factura
          -usuario: Usuario
          -comentarios: List<ComentarioIncidencia>

          +resolver(Usuario usuario) : void 
          +cambiarEstado(EstadoIncidencia estado) : void 
          +asignar(Usuario usuario) : void 
        }

        enum TiposIncidencia {
          ENVIOREBOTADO 
          NIFINCORRECTO 
          PAGONOLOCALIZADO 
          AVISOBAJAAPI 
        }

        enum PrioridadIncidencia {
          ALTA 
          MEDIA 
          BAJA 
        }

        enum EstadoIncidencia {
          PENDIENTE 
          RESUELTA 
        }

        IncidenciaFacturacion "*" --> "1" TiposIncidencia
        IncidenciaFacturacion "*" --> "1" PrioridadIncidencia
        IncidenciaFacturacion "*" --> "1" EstadoIncidencia
        IncidenciaFacturacion "1" --* "*" ComentarioIncidencia

        class ComentarioIncidencia <<entity>> {
          -idComentario : int 
          -nivelVisibilidad : nivelVisibilidadComentarios
          -mensaje : String 
          -fechaHora : Date 
        }

        enum nivelVisibilidadComentarios {
          INTERNOGESTOR 
          GLOBALADMIN 
        }

        ComentarioIncidencia "*" --> "1" nivelVisibilidadComentarios
        IncidenciaFacturacion --|> Tarea 
      }

      package ClasesSolicitudAprobacion {
        class SolicitudAprobacion <<entity>> {
          -idSolicitud : int 
          -tipoOperacion : OperacionesPosibles 
          -valorSolicitado : double 
          -motivo : String 
          -resolucion : Resolucion 
          -fechaResolucion : Date 
          -clienteAsociado : Cliente 
          -facturaAsociada : Factura 
          -aprobador : Usuario 

          +resolver(Usuario usuario) : void 
          +aplazar(Date fecha) : void 
          +requiereAprobacion(double facturacion) : boolean 
          +aprobar(Usuario) : void 
          +rechazar(Usuario, String) : void 
        }

        enum OperacionesPosibles {
          DESCUENTOTEMPORAL
          PRIMERMESGRATIS
          PRECIOPACTADO
          RECTIFICATIVAALTA
          CONDONACIONDEUDA
          FACTURAPUNTUALALTA
        }

        enum Resolucion {
          APROBADA 
          RECHAZADA 
        }

        SolicitudAprobacion "*" --> "1" OperacionesPosibles
        SolicitudAprobacion "*" --> "1" Resolucion 
        SolicitudAprobacion --|> Tarea 
      }
    }
  }
}

package ClasesInforme {
  class Informe <<entity>> {
    -idInforme : int 
    -tipo : String 
    -parametros : JSON 
    -fechaGeneracion : Date 
    -formato : FormatosValidos 
    -usuarioCreador : Usuario 
    -clienteAsociado : Cliente 
    -facturaAsociada : Factura 
    -periodo : PeriodoAdministrativo
    -fechaEmision : Date

    +programar(Date fecha) : void  
  }

  enum FormatosValidos {
    PDF 
    CSV 
  }

  Informe "*" --> "1" FormatosValidos 
  abstract class Archivo 
  class CSV 
  class PDF 
  CSV --|> Archivo
  PDF --|> Archivo 
}

package ClasesAjustesDelSistema {
  class Reloj <<singleton>> {
  +iniciar() : void 
  +resolverTareas() : void 
  +resolverExportaciones() : void 
  +enviarRecurrentes() : void
  +revisarClientesYContactosLimite() : void 
  +revisarEmpleadosLimite() : void  
  +tic() : void 
  }

  Reloj ..> AjustesSistema

  package ClasesPeriodoAdministrativo {
    class PeriodoAdministrativo <<entity>> {
    -idPeriodo: int
    -anyo: int
    -trimestre: int
    -estado: EstadoPeriodo
    -fechaCierre: Date
    -horaCierre: Date
    -autorizacionSuperior: boolean

    +cerrar(Usuario usuario): void
    +reabrir(Usuario usuario, String motivo): void
    +contieneFecha(Date fecha): boolean
    +permiteEmitir(Date fecha): boolean
    }

    enum EstadoPeriodo {
    ABIERTO
    CERRADO
    REABIERTOEXCEPCIONAL
    }

    Informe "*" --> "1" PeriodoAdministrativo
  }

  AjustesSistema ..> PeriodoAdministrativo

  package ClasesComponentesAjustes {
    class AjusteSistemaPuntual <<entity>> {
    -clave : String
    -valor : String
    -tipo : String
    -fechaEfecto : Date 
    -estado : States
    }

    enum States {
    VIGENTE
    PENDIENTE
    RECHAZADA
    }

    AjusteSistemaPuntual "*" --> "1" States

    class Festivo {
    -dia : int 
    -mes : int 
    }

    class AutenticadorValidador <<static>> {
    +verificarCredenciales(String email, String password) : boolean 
    +comprobarPermisos(Usuario usuario, Cliente cliente) : boolean
    +validarCorreo(String correo) : boolean
    +validarPassword(String password) : boolean 
    +validarNIF(String NIF) : boolean 
    +validarCSV(CSV csv) : boolean 
    +validarImporteEnUmbral(Administrador, double) : boolean 
    +validarDatosFiscales(String datosFiscales) : boolean 
    +validarConsultaAPI(String consultaAPI) : boolean 
    }

    package ClasesFiltros {
      interface Filtro<T> {
        aplicarFiltro(T) : boolean  
      }

      package FiltroDeClientes {
        class FiltroClientes <<entity>> {
          -nombreCliente : String 
          -idCliente : int 
          -estado : EstadoCliente 
          -etiquetas : List<Etiqueta> 
          -responsable : Usuario 

          +aplicarFiltro(Cliente) : boolean  
        }

        FiltroClientes ..|> Filtro 
      }

      package FiltroDeFacturas {
        class FiltroFacturas <<entity>> {
          -clienteAsociado : Cliente 
          -importeMaximo : double 
          -importeMinimo : double 
          -estado : EstadoFactura
          -fechaFactura : Date 

          +aplicarFiltro(Factura) : boolean  
        }

        FiltroFacturas ..|> Filtro 
      }

      package FiltroDeMovimientos {
        class FiltroMovimientos <<entity>> {
