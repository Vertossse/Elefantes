@startuml
!pragma layout smetana
skinparam style strictuml
skinparam classAttributeIconSize 0

enum Tipo_Movimiento {
  ALTA_BAJA_CLIENTE
  ALTA_BAJA_USUARIO
  ASIGNACION_CLIENTE
  GENERACION_FACTURA
  RECTIFICACION_FACTURA
  GENERACION_INFORME
  APLICACION_EXCEPCION
  REGISTRO_COBRO
  REGISTRO_TAREA
  CIERRE_PERIODO
  IMPORTACION_CSV
  ENVIO_COMUNICACION
  AUDITORIA
}

abstract class Movimiento <<entity>> {
  -idMovimiento : int
  -fechaHora : Date
  -usuario : Usuario
  +getIdMovimiento() : int
  +getFechaHora() : Date
  +getUsuario() : Usuario
}

class RegistroAuditoria <<entity>>
class EnvioComunicacion <<entity>>
class ImportacionCSV <<entity>>
class CierrePeriodo <<entity>>
class RegistroCobro <<entity>>
class RegistroTarea <<entity>>
class "... (resto de subclases)" as Otras <<entity>>

Movimiento <|-- RegistroAuditoria
Movimiento <|-- EnvioComunicacion
Movimiento <|-- ImportacionCSV
Movimiento <|-- CierrePeriodo
Movimiento <|-- RegistroCobro
Movimiento <|-- RegistroTarea
Movimiento <|-- Otras

class GestorMovimientos <<control>> {
  +registrarMovimiento(tipo : Tipo_Movimiento, usuario : Usuario, datos : Map) : Movimiento
  +registrarAuditoria(tabla : String, idRegistro : String, accion : String, usuario : Usuario, antes : JSON, despues : JSON) : RegistroAuditoria
  +consultarMovimientos(filtro : Filtro) : List<Movimiento>
}

class RepositorioMovimiento {
  +guardar(m : Movimiento) : void
  +buscar(filtro : Filtro) : List<Movimiento>
}

GestorMovimientos ..> Tipo_Movimiento
GestorMovimientos ..> Movimiento : crea
GestorMovimientos --> RepositorioMovimiento
@enduml
