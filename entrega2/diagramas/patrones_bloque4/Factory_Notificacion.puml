@startuml
!pragma layout smetana
skinparam style strictuml
skinparam classAttributeIconSize 0

enum CanalNotificacion {
  CORREO
  WHATSAPP
  USUARIO
}

abstract class Notificacion <<entity>> {
  -idNotificacion : int
  -asunto : String
  -texto : String
  -fecha : Date
  -destinatario : Usuario
}

class Correo <<entity>>
class WhatsApp <<entity>>
class NotificacionUsuario <<entity>> {
  -leida : boolean
}

Notificacion <|-- Correo
Notificacion <|-- WhatsApp
Notificacion <|-- NotificacionUsuario

class GestorTareas <<control>> {
  +notificar(evento : String, destinatario : Usuario, canal : CanalNotificacion) : void
  +crearNotificacion(canal : CanalNotificacion, asunto : String, texto : String) : Notificacion
}

GestorTareas ..> CanalNotificacion
GestorTareas ..> Notificacion : crea
@enduml
