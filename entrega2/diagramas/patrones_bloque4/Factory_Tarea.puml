@startuml
!pragma layout smetana
skinparam style strictuml
skinparam classAttributeIconSize 0

enum Tipo_Tarea {
  DELEGACION_TEMPORAL
  REVISION_ANUAL
  DISPUTA_DEUDA
  INCIDENCIA_FACTURACION
  SOLICITUD_APROBACION
}

enum Ejecutor {
  USUARIO
  SISTEMA
}

abstract class Tarea <<entity>> {
  -idTarea : int
  -estado : String
  -ejecutor : Ejecutor
  -fechaCreacion : Date
  -fechaFin : Date
  +atender(usuario : Usuario) : void
  +aplazar(fecha : Date) : void
}

class DelegacionTemporal <<entity>>
class RevisionAnual <<entity>>
class DisputaDeuda <<entity>>
class IncidenciaFacturacion <<entity>> {
  -tipo : String
  -prioridad : String
  -comentarios : List<ComentarioIncidencia>
}
class SolicitudAprobacion <<entity>>

Tarea <|-- DelegacionTemporal
Tarea <|-- RevisionAnual
Tarea <|-- DisputaDeuda
Tarea <|-- IncidenciaFacturacion
Tarea <|-- SolicitudAprobacion

class GestorTareas <<control>> {
  +crearTarea(tipo : Tipo_Tarea, datos : Map) : Tarea
  +atenderTarea(t : Tarea) : void
  +aplazarTarea(t : Tarea, fecha : Date) : void
  +abrirIncidencia(datos : Map) : IncidenciaFacturacion
}

class RepositorioTareas {
  +guardar(t : Tarea) : void
  +buscar(filtro : Filtro) : List<Tarea>
}

GestorTareas ..> Tipo_Tarea
GestorTareas ..> Tarea : crea
GestorTareas --> RepositorioTareas
@enduml
