@startuml SEC-08
skinparam style strictuml
skinparam maxMessageSize 180
autonumber
title SEC-08 - Gestión de la suscripción de un cliente

actor "Usuario\n(AD / SA / UO)"     as Usuario
control "GestorSuscripciones"       as GS
control "GestorClientes"            as GC
control "AutenticadorValidador"     as AV
control "GestorMovimientos"         as GM
entity "Cliente"                    as Cliente
entity "Suscripcion"                as Suscripcion
entity "TarifaRango"                as Tarifa
database "RepositorioCliente"       as RC
database "Repositorio<Suscripcion>" as RS

Usuario -> GS : obtenerDatosCliente(nif)
GS -> GC : obtenerClientePorNif(nif)
GC -> RC : buscarPuntual(idCliente)
RC --> GC : cliente
GC --> GS : cliente
GS -> RS : buscarPorCliente(cliente)
RS --> GS : suscripcion
GS --> Usuario : cliente, suscripcion

Usuario -> GS : solicitarAltaSuscripcion(inicio, plan, tarifa, responsable, plazo, contrato)
opt Inicio distinto del día 1 y sin prorrateo
  GS -> Suscripcion : calcularProrrateoPrimerMes()
  Suscripcion --> GS : importeProrrateo
  GS --> Usuario : importeProrrateo
end

Usuario -> GS : crearSuscripcion(cliente, inicio, plan, tarifa, responsable, plazo, contrato, sinProrrateo)
GS -> AV : comprobarPermiso(usuario, "crearSuscripcion", cliente)
AV --> GS : boolean

alt Sin permiso
  GS --> Usuario : error de permisos
else Permiso concedido
  GS -> Cliente : tieneDatosFiscalesCompletos()
  Cliente --> GS : boolean
  alt Faltan datos fiscales
    GS --> Usuario : error de datos fiscales
  else Datos fiscales completos
    GS -> Tarifa : esValidaEn(inicio)
    Tarifa --> GS : boolean
    alt Tarifa no vigente
      GS --> Usuario : error de tarifa
    else Tarifa vigente
      GS -> Suscripcion : crear(inicio, plan, tarifa, responsable, plazo, contrato)
      GS -> RS : agregar(suscripcion)
      GS -> GM : registrarAuditoria("Suscripcion", idSuscripcion, Alta, usuario, null, datos)
      GM --> GS : registrado
      GS --> Usuario : suscripcion creada
    end
  end
end

opt Pausar la suscripción
  Usuario -> GS : pausarSuscripcion(suscripcion, motivo, inicio, finPrevisto)
  GS -> Suscripcion : esPausaValida(motivo, inicio, finPrevisto)
  Suscripcion --> GS : boolean
  alt Pausa inválida
    GS --> Usuario : error de validación
  else Pausa válida
    GS -> Suscripcion : pausar(motivo, inicio, finPrevisto)
    GS -> RS : actualizar(suscripcion)
    GS -> GM : registrarAuditoria("Suscripcion", idSuscripcion, Modificacion, usuario, estadoAnterior, Pausada)
    GM --> GS : registrado
    GS --> Usuario : suscripción pausada
  end
end

opt Reactivar la suscripción
  Usuario -> GS : reactivarSuscripcion(suscripcion)
  GS -> Suscripcion : reactivar()
  GS -> RS : actualizar(suscripcion)
  GS -> GM : registrarAuditoria("Suscripcion", idSuscripcion, Modificacion, usuario, Pausada, Activa)
  GM --> GS : registrado
  GS --> Usuario : suscripción activa
end

@enduml
