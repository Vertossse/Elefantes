@startuml SEC-09
skinparam style strictuml
skinparam maxMessageSize 180
autonumber
title SEC-09 - Revisión anual del rango de un cliente

actor "Usuario\n(AD / SA)"              as Usuario
actor "Aprobador\n(AD / SA)"            as Aprobador
control "GestorSuscripciones"           as GS
control "GestorSistema"                 as GSist
control "GestorClientes"                as GC
control "GestorAprobaciones"            as GA
control "AutenticadorValidador"         as AV
control "GestorMovimientos"             as GM
entity "Cliente"                        as Cliente
entity "RevisionAnual"                  as Revision
entity "TarifaRango"                    as Tarifa
entity "Suscripcion"                    as Suscripcion
database "Repositorio<RevisionAnual>"   as RRA
database "Repositorio<TarifaRango>"     as RT
database "Repositorio<Suscripcion>"     as RS
database "RepositorioCliente"           as RC

Usuario -> GS : listarRevisionesPendientes()
GS -> RRA : buscarPendientes()
RRA --> GS : revisiones
GS --> Usuario : revisiones

Usuario -> GS : seleccionarCliente(nif)
GS -> GC : obtenerClientePorNif(nif)
GC -> RC : buscarPuntual(idCliente)
RC --> GC : cliente
GC --> GS : cliente
GS --> Usuario : cliente

Usuario -> GS : iniciarRevision(cliente, facturacionAnualVerificada, solicitante)
GS -> AV : comprobarPermiso(usuario, "revisarRango", cliente)
AV --> GS : boolean

alt Sin permiso
  GS --> Usuario : error de permisos
else Permiso concedido
  GS -> Revision : crear(cliente, solicitante)
  GS -> Revision : registrarFacturacion(revision, facturacionAnualVerificada)
  GS -> GSist : obtenerTarifasVigentes(fechaRevision)
  GSist -> RT : buscarVigentes(fechaRevision)
  RT --> GSist : tarifas
  GSist --> GS : tarifas
  GS -> Revision : calcularTarifaPropuesta(tarifas)
  Revision --> GS : tarifaCalculada
  alt Se mantiene el mismo tramo
    GS -> Revision : mantener()
    GS -> RRA : agregar(revision)
    GS -> GM : registrarAuditoria("RevisionAnual", idRevision, Modificacion, usuario, null, Mantenida)
    GM --> GS : registrado
    GS --> Usuario : revisión mantenida, sin cambio de precio
  else Cambio de tramo
    GS -> RRA : agregar(revision)
    GS -> GM : registrarAuditoria("RevisionAnual", idRevision, Alta, usuario, null, Pendiente)
    GM --> GS : registrado
    GS --> Usuario : tarifaAnterior, tarifaCalculada
    note over GS
      La propuesta queda pendiente de aprobación.
      El precio no cambia hasta que se apruebe.
    end note
  end
end

Aprobador -> GA : obtenerRevisionPendiente(revision)
GA --> Aprobador : revision, tarifaAnterior, tarifaCalculada

Aprobador -> GA : aprobarRevision(revision, aprobador, tarifaCalculada)
GA -> AV : comprobarPermiso(aprobador, "aprobarRevision", cliente)
AV --> GA : boolean
alt Sin permiso
  GA --> Aprobador : error de permisos
else Permiso concedido
  GA -> AV : comprobarSeparacionFunciones(solicitante, aprobador)
  AV --> GA : boolean
  alt Autoaprobación no permitida
    GA --> Aprobador : error de separación de funciones
  else Separación válida
    GA -> Revision : aprobar(aprobador, tarifaCalculada)
    GA -> GS : actualizarSuscripcion(cliente, idSuscripcion, nuevaSuscripcion, tarifaCalculada, fechaEfecto)
    GS -> Suscripcion : aplicarNuevaTarifa(tarifaCalculada, fechaEfecto)
    GS -> RS : actualizar(suscripcion)
    GA -> RRA : actualizar(revision)
    GA -> GM : registrarAuditoria("RevisionAnual", idRevision, Modificacion, aprobador, precioAnterior, precioNuevo)
    GM --> GA : registrado
    GA --> Aprobador : revisión aprobada
  end
end

opt Rechazo del cambio de rango
  Aprobador -> GA : rechazarRevision(revision, aprobador, motivo)
  GA -> AV : comprobarPermiso(aprobador, "rechazarRevision", cliente)
  GA -> AV : comprobarSeparacionFunciones(solicitante, aprobador)
  GA -> Revision : rechazar(aprobador)
  GA -> RRA : actualizar(revision)
  GA -> GM : registrarAuditoria("RevisionAnual", idRevision, Modificacion, aprobador, Pendiente, Rechazada)
  GM --> GA : registrado
  GA --> Aprobador : revisión rechazada, tarifa anterior mantenida
end

@enduml
