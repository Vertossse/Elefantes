@startuml SEC-11
skinparam style strictuml
skinparam maxMessageSize 180
autonumber
title SEC-11 - Aprobación o rechazo de solicitudes

actor "Usuario\n(AD / SA)"                       as Usuario
control "GestorAprobaciones"                     as GA
control "AutenticadorValidador"                  as AV
control "GestorMovimientos"                      as GM
entity "SolicitudAprobacion"                     as Solicitud
entity "RevisionAnual"                           as Revision
database "Repositorio<SolicitudAprobacion>"      as RSA
database "Repositorio<RevisionAnual>"            as RRA
database "RepositorioEmpleado"                   as RE

Usuario -> GA : listarPendientes(usuario)
GA -> RSA : buscarPendientesPorAprobador(usuario)
RSA --> GA : solicitudes
GA -> RRA : buscarPendientes()
RRA --> GA : revisiones
GA --> Usuario : tareas

Usuario -> GA : obtenerDetalle(tarea)
GA --> Usuario : tarea, valorAnterior, valorNuevo

Usuario -> GA : aprobar(tarea, aprobador, comentario)
note right of GA
  El gestor despacha según el tipo de tarea:
  SolicitudAprobacion o RevisionAnual.
end note
GA -> AV : comprobarPermiso(aprobador, "aprobar", cliente)
AV --> GA : boolean

alt Sin permiso
  GA --> Usuario : error de permisos
else Permiso concedido
  GA -> AV : comprobarSeparacionFunciones(solicitante, aprobador)
  AV --> GA : boolean
  alt Autoaprobación no permitida
    GA --> Usuario : error de separación de funciones
  else Separación válida
    GA -> AV : validarImporteEnUmbral(valorSolicitado, umbralAprobacion)
    AV --> GA : boolean
    alt Importe por encima del umbral
      GA --> Usuario : derivar al superadministrador
    else Dentro del umbral
      alt La tarea es una SolicitudAprobacion
        GA -> Solicitud : aprobar(aprobador, comentario)
        GA -> GA : aplicarOperacion(solicitud)
        GA -> RSA : actualizar(solicitud)
        GA -> GM : registrarAuditoria("SolicitudAprobacion", idSolicitud, Modificacion, aprobador, Pendiente, Aprobada)
        GM --> GA : registrado
        GA -> GA : notificarSolicitante(solicitud)
        GA --> Usuario : solicitud aprobada
      else La tarea es una RevisionAnual
        GA -> Revision : aprobar(aprobador, tarifaCalculada)
        GA -> RRA : actualizar(revision)
        GA -> GM : registrarAuditoria("RevisionAnual", idRevision, Modificacion, aprobador, precioAnterior, precioNuevo)
        GM --> GA : registrado
        GA -> GA : notificarSolicitante(revision)
        GA --> Usuario : revisión aprobada
        note right of GA
          La revisión aprobada aplica la nueva
          tarifa a la suscripción del cliente.
        end note
      end
    end
  end
end

opt Rechazo de la tarea
  Usuario -> GA : rechazar(tarea, aprobador, motivo)
  GA -> AV : comprobarPermiso(aprobador, "rechazar", cliente)
  GA -> Solicitud : rechazar(aprobador, motivo)
  GA -> RSA : actualizar(solicitud)
  GA -> GM : registrarAuditoria("SolicitudAprobacion", idSolicitud, Modificacion, aprobador, Pendiente, Rechazada)
  GM --> GA : registrado
  GA -> GA : notificarSolicitante(solicitud)
  GA --> Usuario : solicitud rechazada
end

opt Reasignación por ausencia
  Usuario -> GA : reasignar(tarea, nuevoAprobador, administrador)
  GA -> AV : comprobarPermiso(administrador, "reasignar", cliente)
  AV --> GA : boolean
  alt Sin permiso
    GA --> Usuario : error de permisos
  else Permiso concedido
    GA -> Solicitud : reasignar(nuevoAprobador)
    GA -> RSA : actualizar(solicitud)
    GA -> GM : registrarAuditoria("SolicitudAprobacion", idSolicitud, Reasignacion, administrador, aprobadorAnterior, nuevoAprobador)
    GM --> GA : registrado
    GA --> Usuario : tarea reasignada
  end
end

@enduml
