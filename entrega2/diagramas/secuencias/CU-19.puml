@startuml SEC-19
skinparam style strictuml
skinparam maxMessageSize 180
autonumber
title SEC-19 - Gestión de una disputa

actor "Usuario\n(AD / UO)"                  as Usuario
boundary "FichaCliente"                     as Ficha
boundary "VentanaDisputa"                   as Ventana
control "GestorCobros"                      as GC
control "GestorFacturas"                    as GF
control "GestorClientes"                    as GCli
control "GestorAprobaciones"                as GA
control "AutenticadorValidador"             as AV
control "GestorMovimientos"                 as GM
entity "Cliente"                            as Cliente
entity "Factura"                            as Factura
entity "DisputaDeuda"                       as Disputa
entity "SolicitudAprobacion"                as Solicitud
database "RepositorioDisputas"              as RD
database "RepositorioFacturas"              as RF
database "RepositorioSolicitudesAprobacion" as RSA
database "RepositorioClientes"              as RC

Usuario -> Ficha : abrir ficha del cliente
Ficha -> GCli : obtenerClientePorNif(nif)
GCli -> RC : buscarPorNif(nif)
RC --> GCli : cliente
GCli --> Ficha : cliente
Ficha -> GF : listarPorCliente(cliente)
GF -> RF : buscarPorCliente(cliente)
RF --> GF : facturas
GF --> Ficha : facturas
Ficha --> Usuario : mostrarFacturas(facturas)

Usuario -> Ficha : seleccionar factura reclamada
Ficha -> Ventana : abrirDisputa(factura)
Ventana --> Usuario : mostrarFactura(factura)
Usuario -> Ventana : introducir motivo y fecha de revisión
Usuario -> Ventana : confirmar()
Ventana -> GC : abrirDisputa(factura, motivo, fechaRevision, usuario)
GC -> AV : comprobarPermiso(usuario, "abrirDisputa", cliente)
AV --> GC : boolean

alt Sin permiso
  GC --> Ventana : error de permisos
  Ventana --> Usuario : mostrarError(mensaje)
else Permiso concedido
  GC -> AV : validarMotivo(motivo)
  AV --> GC : boolean
  alt Motivo inválido
    GC --> Ventana : error de motivo
    Ventana --> Usuario : mostrarError(mensaje)
  else Motivo válido
    GC -> Disputa : crear(motivo, fechaRevision, factura, cliente, empleado)
    GC -> Disputa : congelarRecordatorios()
    GC -> RD : guardar(disputa)
    GC -> GM : registrarAuditoria("DisputaDeuda", idDisputa, Alta, usuario, null, datos)
    GM --> GC : registrado
    GC --> Ventana : disputa registrada
    Ventana --> Usuario : confirmación
    note over Factura : La deuda sigue como no cobrada y los avisos quedan congelados.
  end
end

opt Cancelar la deuda
  Usuario -> Ventana : seleccionar cancelar deuda
  Ventana -> GC : cancelarDeuda(factura, motivo, usuario)
  GC -> AV : comprobarPermiso(usuario, "cancelarDeuda", cliente)
  GC -> AV : validarMotivo(motivo)
  GC -> GA : solicitar(TipoOperacionAprobacion.CondonacionDeuda, factura, motivo, usuario)
  GA -> Solicitud : crear(tipoOperacion, valorSolicitado, motivo, cliente, factura, solicitante)
  GA -> RSA : guardar(solicitud)
  GA --> GC : solicitud
  GC -> GM : registrarAuditoria("SolicitudAprobacion", idSolicitud, Alta, usuario, null, datos)
  GC --> Ventana : solicitud pendiente
  Ventana --> Usuario : pendiente de aprobación (CU-11)
end

opt Declarar la deuda incobrable
  Usuario -> Ventana : seleccionar declarar incobrable
  Ventana -> GC : declararIncobrable(factura, motivo, usuario)
  GC -> AV : comprobarPermiso(usuario, "declararIncobrable", cliente)
  GC -> AV : validarMotivo(motivo)
  GC -> GA : solicitar(TipoOperacionAprobacion.CondonacionDeuda, factura, motivo, usuario)
  GA -> Solicitud : crear(tipoOperacion, valorSolicitado, motivo, cliente, factura, solicitante)
  GA -> RSA : guardar(solicitud)
  GA --> GC : solicitud
  GC -> GM : registrarAuditoria("SolicitudAprobacion", idSolicitud, Alta, usuario, null, datos)
  GC --> Ventana : solicitud pendiente
  Ventana --> Usuario : pendiente de aprobación (CU-11)
end

@enduml
