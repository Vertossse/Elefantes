@startuml SEC-21
skinparam style strictuml
skinparam maxMessageSize 180
autonumber
title SEC-21 - Conciliación manual de un cobro

actor "Usuario\n(AD / UO)"              as Usuario
boundary "VentanaConciliacion"          as Ventana
control "GestorCobros"                  as GC
control "AutenticadorValidador"         as AV
control "GestorMovimientos"             as GM
entity "Conciliacion"                   as Conciliacion
entity "Factura"                        as Factura
database "RepositorioMovimientosCobro"  as RMC
database "RepositorioConciliaciones"    as RCon
database "RepositorioFacturas"          as RF

Usuario -> Ventana : abrir conciliación manual
Ventana -> GC : listarPendientes(usuario)
GC -> RMC : buscarPendientes()
RMC --> GC : movimientos
GC --> Ventana : movimientos
Ventana --> Usuario : mostrar movimientos pendientes

Usuario -> Ventana : seleccionar movimiento
Ventana -> GC : buscarFacturasCandidatas(movimiento)
GC -> RF : buscarPendientes()
RF --> GC : facturas
GC --> Ventana : facturasCandidatas
Ventana --> Usuario : mostrarFacturasCandidatas(facturas)

Usuario -> Ventana : seleccionar factura
Ventana -> GC : conciliarManual(movimiento, factura, usuario)
GC -> AV : comprobarPermiso(usuario, "conciliarManual", cliente)
AV --> GC : boolean

alt Sin permiso o cliente fuera de la cartera
  GC --> Ventana : error de permisos
  Ventana --> Usuario : mostrarError(mensaje)
else Permiso concedido
  GC -> Factura : puedeConciliarse()
  Factura --> GC : boolean
  alt Factura anulada o ya cobrada
    GC --> Ventana : error de estado
    Ventana --> Usuario : mostrarError(mensaje)
  else Factura conciliable
    GC -> Conciliacion : crear(TipoConciliacion.Manual, discrepancia, fecha, Conciliado, movimiento, factura)
    GC -> RCon : guardar(conciliacion)
    GC -> Factura : marcarPagada()
    GC -> RF : guardar(factura)
    GC -> GM : registrarAuditoria("Conciliacion", idConciliacion, Conciliacion, usuario, null, datos)
    GM --> GC : registrado
    GC --> Ventana : conciliación
    Ventana --> Usuario : confirmación
  end
end

opt Conciliación deshecha
  Usuario -> Ventana : deshacer(motivo)
  Ventana -> GC : revertirConciliacion(conciliacion, motivo, usuario)
  GC -> AV : comprobarPermiso(usuario, "revertirConciliacion", cliente)
  AV --> GC : boolean
  alt Sin permiso
    GC --> Ventana : error de permisos
    Ventana --> Usuario : mostrarError(mensaje)
  else Permiso concedido
    GC -> Conciliacion : revertir(motivo)
    GC -> RCon : guardar(conciliacion)
    GC -> RF : guardar(factura)
    GC -> GM : registrarAuditoria("Conciliacion", idConciliacion, Modificacion, usuario, datosAnteriores, datosNuevos)
    GM --> GC : registrado
    GC --> Ventana : conciliación revertida
    Ventana --> Usuario : confirmación
    note right of Ventana : La factura vuelve a su estado anterior y queda la traza del motivo.
  end
end

@enduml
