@startuml

header CU-26
title Flujo Principal 

actor Empleado
database Database 
group Buscar por Clientes 
  loop Tantas busquedas de clientes como el usuario quiera 
  Empleado -> GestorClientes : BuscarClientes(Filtros) 
  GestorClientes -> RepositorioCliente : BuscarClientes (Filtros)
  RepositorioCliente -> Database : Consulta 
  Database --> RepositorioCliente : List<Cliente>
  RepositorioCliente --> GestorCliente : List<Cliente> 
  GestorCliente --> Empleado : List<Cliente>
  end loop
end group 

